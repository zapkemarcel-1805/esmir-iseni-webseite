# ── Supabase ──────────────────────────────────────────────
# Projekt-URL und Service-Role-Key aus Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...   # GEHEIM — niemals im Browser/Client verwenden

# ── Resend (E-Mail-Versand) ─────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Verifizierte Absenderadresse (eigene Domain bei Resend verifizieren!)
# NICHT die Hotmail-Adresse als Absender verwenden.
EMAIL_FROM="ESMIR ISENI <termine@ihre-domain.de>"
# Empfängeradresse für neue Terminanfragen (Standard: iseniesmir@hotmail.com)
OWNER_NOTIFICATION_EMAIL=iseniesmir@hotmail.com

# ── Öffentliche Website-URL ─────────────────────────────────
# Wird für die Bestätigungs-/Ablehnungslinks in E-Mails benötigt.
# Lokal: http://localhost:3000
# Produktion: https://ihre-domain.de
NEXT_PUBLIC_SITE_URL=http://localhost:3000
